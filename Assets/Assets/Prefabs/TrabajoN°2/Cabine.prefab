  m_Script: {fileID: 11500000, guid: 3234b93125032c243a31371fd49c2a77, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextoBateria
  batterySocket: {fileID: 3269404087807796032}
  texto: {fileID: 5426951107876584000}
  textoAntes: "Da\xF1o grave en el motor central.\n\nProceda a ejecutar recuperacion
    de emergencia, y proceda con la mision: \n\n1.- Ponga la bateria de emergencia
    en el compartimiento designado"
  textoDespues: "Bater\xEDa conectada.\nProceda a destruir los objetivos.\nCon la
    rueda puede ajustar la altura de la camara.\nEl joistick apunta el ca\xF1on.\nEl
    botton dispara.\nEl Slider ajusta el sonido del exterior."
